# Bantay Baha — env template
# Copy to .env and edit. Never commit .env.

# --- Database ---
# MariaDB/MySQL (URL-encode special characters in user/password):
DATABASE_URL=mysql+pymysql://bantay:secret@localhost:3306/bantay_baha?charset=utf8mb4
# SQLite remains available only for isolated local tests: sqlite:///./bantay_baha.db

# --- Storage ---
# Production MVP: gzip-compressed response bodies are stored in source_snapshot.raw_body_gzip.
STORAGE_BACKEND=database
SNAPSHOT_MAX_RAW_BYTES=2000000
SNAPSHOT_MAX_COMPRESSED_BYTES=1000000
SNAPSHOT_DATABASE_QUOTA_BYTES=250000000
# Optional local development/legacy backend:
SNAPSHOT_DIR=./storage/snapshots
# Optional S3-compatible scaling backend (requires the dev `boto3` extra):
# S3_ENDPOINT_URL=https://s3.example.com
# S3_BUCKET=bantay-baha-snapshots
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=ap-southeast-1

# --- API ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=https://bettermalolos.org,http://localhost:8000,http://localhost:3000
OPS_API_TOKEN=change-me-in-production

# --- Collectors ---
PDRRMO_URL=https://pdrrmo.bulacan.gov.ph/
PDRRMO_ENABLED=false
# Keep disabled until source acceptance (terms_reviewed_at, robots, permission) is approved. Synthetic/fixture runs still work via --fixture.
PDRRMO_CADENCE_MINUTES=30
COLLECTOR_USER_AGENT=BantayBaha/0.1 (+https://bettermalolos.org/bantay-baha; contact: ops@bettermalolos.org)
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2

# --- Freshness (minutes) ---
FRESHNESS_WARNING_MINUTES=45
FRESHNESS_CRITICAL_MINUTES=90
TIDE_WARNING_HOURS=36
TIDE_CRITICAL_HOURS=72

# --- Alembic ---
# ALEMBIC_DATABASE_URL is read by alembic env if DATABASE_URL is sqlite with relative path
