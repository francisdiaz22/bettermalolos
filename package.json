{
  "name": "bs-web",
  "version": "1.0.4",
  "description": "BetterMalolos.org - Independent, community-built civic tools for Malolos",
  "scripts": {
    "dev": "python3 serve.py -p 8000 -d .",
    "build": "bash build.sh",
    "build:major": "bash scripts/version.sh major && bash build.sh --no-bump",
    "build:minor": "bash scripts/version.sh minor && bash build.sh --no-bump",
    "serve": "python3 serve.py -p 8000 -d .",
    "serve:dist": "python3 serve.py -p 8080 -d dist",
    "version:major": "node scripts/bump-version.js major",
    "version:minor": "node scripts/bump-version.js minor",
    "version:patch": "node scripts/bump-version.js patch",
    "version:check": "node scripts/bump-version.js",
    "test": "playwright test",
    "test:chrome": "playwright test --project=chrome",
    "test:report": "playwright show-report",
    "sync:navigation": "node scripts/sync-navigation.js",
    "check:navigation": "node scripts/sync-navigation.js --check",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "bash scripts/package-cpanel.sh --build",
    "package:only": "bash scripts/package-cpanel.sh"
  },
  "keywords": [
    "malolos",
    "bulacan",
    "government",
    "lgu"
  ],
  "author": "Ramon Logan Jr.",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.23.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "clean-css-cli": "^5.6.3",
    "core-js": "^3.40.0",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.61.0",
    "prettier": "^3.8.1",
    "terser": "^5.44.1"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "brace-expansion": "5.0.9",
    "dunder-proto": "1.0.1",
    "es-define-property": "1.0.1",
    "events-universal": "1.0.1",
    "get-proto": "1.0.1",
    "ip-address": "10.3.1",
    "tmp": "0.2.7",
    "js-yaml": "4.3.1",
    "parse-cache-control": "1.0.1",
    "path-is-absolute": "1.0.1",
    "side-channel-list": "1.0.1",
    "side-channel-map": "1.0.1",
    "teex": "1.0.1",
    "toidentifier": "1.0.1",
    "uuid": "^11.1.1",
    "utils-merge": "1.0.1"
  }
}